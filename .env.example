# Database
MONGO_URI=mongodb://127.0.0.1:27017/creonox-crm

# API
PORT=5500
APP_URL=http://localhost:3001

# Stripe (subscription SaaS) — https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create Products & Prices in Stripe Dashboard, then paste Price IDs:
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# Webhook URL to register in Stripe: https://your-api-domain.com/api/billing/webhook

# ── Email (workspace invites, etc.) — choose one setup ─────────────────────
# Gmail: EMAIL_USER = full address, EMAIL_PASS = 16-char App Password (NOT your Gmail password).
# App passwords: https://myaccount.google.com/apppasswords (2-Step Verification must be on).
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=abcdefghijklmnop
# App Passwords are always 16 letters (Google may show 4 groups — remove spaces in .env).
# If .env mangles the password, use base64 instead of EMAIL_PASS:
#   node -e "console.log(Buffer.from('YOUR_16_CHAR_APP_PASSWORD','utf8').toString('base64'))"
# EMAIL_PASS_BASE64=xxxxxxxx
# Default Gmail transport uses port 587 + STARTTLS. For SSL on 465: EMAIL_GMAIL_USE_SSL=true
# SMTP debug: EMAIL_DEBUG=1
# Optional separate display From (defaults to EMAIL_USER):
# EMAIL_FROM="Creonox ERP <you@gmail.com>"

# Generic SMTP (Microsoft 365, SendGrid SMTP, Mailgun, SES, etc.):
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=mailbox@company.com
# EMAIL_PASS=...

# Or a single URL (password must be URL-encoded if it contains @ # etc.):
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# Optional: tighten API rate limit (requests per 15 min per IP)
# RATE_LIMIT_MAX=500
